---
// Página da série (/podcast). A lista "no site" sai dos episódios
// publicados em src/content/podcast, do mais novo para o mais antigo.
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { publicados, titulo } from '../lib/posts';
import { SITE, dataPorExtenso } from '../lib/site';

const episodios = await publicados('podcast');
const itens = episodios.map((ep, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  url: `${SITE}/${ep.id}`,
  name: titulo(ep),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "PodcastSeries",
      "@id": "https://www.cristianocre.com/podcast#serie",
      "name": "Performance para Resultados",
      "alternateName": "Podcast Performance para Resultados",
      "description": "Podcast sobre e-commerce, marketing de performance e gestão, com conversas com donos de operação sobre aquisição, margem, time e as decisões que fazem uma marca crescer.",
      "inLanguage": "pt-BR",
      "url": "https://www.cristianocre.com/podcast",
      "image": "https://www.cristianocre.com/img/podcast-performance-para-resultados.jpg",
      "webFeed": "https://www.youtube.com/feeds/videos.xml?channel_id=UClDIQjliJFirXWqkXQ7fPRA",
      "author": {
        "@id": "https://www.cristianocre.com/#cristiano"
      },
      "producer": {
        "@id": "https://www.cristianocre.com/#metris"
      },
      "publisher": {
        "@id": "https://www.cristianocre.com/#metris"
      },
      "sameAs": [
        "https://www.youtube.com/@PerformanceParaResultados",
        "https://www.youtube.com/channel/UClDIQjliJFirXWqkXQ7fPRA",
        "https://open.spotify.com/show/3rxfDidW1vHQhrmdpZnAcc"
      ]
    },
    {
      "@type": "Person",
      "@id": "https://www.cristianocre.com/#cristiano",
      "name": "Cristiano Creczyenski",
      "url": "https://www.cristianocre.com",
      "jobTitle": "CEO da Metris",
      "description": "Especialista em marketing de performance e e-commerce, com mais de 17 anos de experiência.",
      "sameAs": [
        "https://www.linkedin.com/in/cristianocre/",
        "https://br.linkedin.com/in/cristianocre",
        "https://www.instagram.com/cristianocre",
        "https://www.youtube.com/@cristianocre",
        "https://www.youtube.com/@PerformanceParaResultados"
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://www.cristianocre.com/#metris",
      "name": "Metris",
      "url": "https://metris.digital/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.cristianocre.com/metris-icon.png"
      }
    },
    {
      "@type": "CollectionPage",
      "@id": "https://www.cristianocre.com/podcast",
      "url": "https://www.cristianocre.com/podcast",
      "name": "Podcast Performance para Resultados | Cristiano Creczyenski",
      "description": "O podcast de e-commerce e marketing de performance apresentado por Cristiano Creczyenski. Conversas com donos de operação sobre aquisição, margem, time e as decisões que fazem uma loja crescer.",
      "inLanguage": "pt-BR",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.cristianocre.com/#site",
        "url": "https://www.cristianocre.com",
        "name": "Cristiano Creczyenski"
      },
      "about": {
        "@id": "https://www.cristianocre.com/podcast#serie"
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": "Episódios do Performance para Resultados publicados no site",
        "numberOfItems": itens.length,
        "itemListElement": itens
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que é o podcast Performance para Resultados?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "É o podcast da Metris, apresentado por Cristiano Creczyenski, com conversas longas com donos e responsáveis por operações que vendem pela internet. O foco é a decisão por trás do resultado: o que a empresa mudou, por que mudou, o que deu errado antes e o que ela faria diferente hoje."
          }
        },
        {
          "@type": "Question",
          "name": "Onde eu escuto o podcast?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os episódios em vídeo ficam no canal Performance para Resultados no YouTube, e o áudio está no Spotify. Nesta página você vê sempre os episódios mais recentes direto do canal, sem precisar sair do site."
          }
        },
        {
          "@type": "Question",
          "name": "O podcast é o mesmo canal do @cristianocre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. São dois canais diferentes e de propósito. O @cristianocre é o canal de conteúdo e aulas do Cristiano, onde ele ensina método. O @PerformanceParaResultados é o canal do podcast, com as entrevistas. Um ensina, o outro conversa."
          }
        },
        {
          "@type": "Question",
          "name": "Com que frequência sai episódio novo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cadência é semanal. Quando um episódio rende um tema que vale ficar registrado por escrito, ele também vira um artigo aqui no site, com o resumo do que foi dito e o que dá para aplicar na sua operação."
          }
        },
        {
          "@type": "Question",
          "name": "Para quem é o podcast?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Para quem é dono do resultado de uma operação: dono de e-commerce, sócio, diretor comercial ou responsável pelo P&L. Não é um programa sobre como vender serviço de tráfego, é sobre como fazer uma marca crescer com margem."
          }
        },
        {
          "@type": "Question",
          "name": "Quem apresenta?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cristiano Creczyenski, CEO da Metris, com mais de 17 anos em marketing de performance e e-commerce. Ele conduz o episódio a partir da operação real, então a conversa costuma descer para número, processo e decisão em vez de ficar em teoria."
          }
        },
        {
          "@type": "Question",
          "name": "Como participar do podcast como convidado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O convite parte da produção e o critério é ter uma operação real e uma história com aprendizado concreto, inclusive do que não deu certo. Se você acha que é o caso, o caminho mais direto é falar com o Cristiano pelo LinkedIn ou pelo Instagram."
          }
        },
        {
          "@type": "Question",
          "name": "Os episódios viram conteúdo escrito?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Os que rendem tema aplicável, sim. O artigo não é uma transcrição: é a leitura do Cristiano sobre o que foi dito, com o contexto de mercado e a ligação com os guias do site. O episódio da Senplo, sobre lançamento semanal, é o exemplo mais recente."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.cristianocre.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Insights",
          "item": "https://www.cristianocre.com/insights"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Podcast Performance para Resultados",
          "item": "https://www.cristianocre.com/podcast"
        }
      ]
    }
  ]
};
---
<Base
  titulo={"Podcast Performance para Resultados | Cristiano Creczyenski"}
  descricao={"O podcast de e-commerce e marketing de performance apresentado por Cristiano Creczyenski. Conversas com donos de operação sobre aquisição, margem, time e as decisões que fazem uma loja crescer."}
  ogTitulo={"Podcast Performance para Resultados | Cristiano Creczyenski"}
  ogDescricao={"O podcast de e-commerce e marketing de performance apresentado por Cristiano Creczyenski. Conversas com donos de operação sobre aquisição, margem, time e as decisões que fazem uma loja crescer."}
  imagem={"https://www.cristianocre.com/img/podcast-performance-para-resultados.jpg"}
  imagemAlt={"Podcast Performance para Resultados, apresentado por Cristiano Creczyenski"}
  canonico={"https://www.cristianocre.com/podcast"}
  jsonLd={jsonLd}
  feedYoutube
>
<section class="page-hero">
  <div class="wrap">
    <span class="pill"><span class="dot"></span>Podcast</span>
    <h1>Performance para <span class="accent">Resultados</span></h1>
    <p class="sub">O podcast em que eu sento com quem opera de verdade e pergunto o que ninguém pergunta: o que vocês mudaram, quanto custou descobrir isso e o que vocês fariam diferente hoje. Sem palco, sem discurso de palestra.</p>
    <div class="plats">
      <a class="plat" href="https://open.spotify.com/show/3rxfDidW1vHQhrmdpZnAcc" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14 4.38-1.32 9.78-.66 13.5 1.62.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.22 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.2-1.26 11.22-1.02 15.6 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.5.3z"/></svg>
        Ouvir no Spotify
      </a>
      <a class="plat" href="https://www.youtube.com/@PerformanceParaResultados" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.56 12 3.56 12 3.56s-7.5 0-9.38.52A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.12 2.12c1.88.52 9.38.52 9.38.52s7.5 0 9.38-.52a3 3 0 0 0 2.12-2.12A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"/></svg>
        Ver no YouTube
      </a>
    </div>
  </div>
</section>

<!-- Últimos episódios, direto do canal -->
<section class="section" id="episodios" style="padding-top:40px">
  <div class="wrap">
    <div class="carousel-top reveal">
      <div class="sec-head" style="text-align:left;margin:0;max-width:660px">
        <span class="pill"><span class="dot"></span>No ar agora</span>
        <h2>Últimos episódios</h2>
        <p>Puxados direto do canal do podcast. Clique para assistir sem sair daqui.</p>
      </div>
      <div class="car-nav">
        <button data-car="podHubCarousel" data-dir="prev" aria-label="Episódio anterior"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
        <button data-car="podHubCarousel" data-dir="next" aria-label="Próximo episódio"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
    </div>
    <div class="pod-carousel yt-carousel" id="podHubCarousel" aria-busy="true" aria-label="Últimos episódios do podcast Performance para Resultados"
         data-yt-canal="podcast"
         data-yt-layout="quote"
         data-yt-link="https://www.youtube.com/@PerformanceParaResultados"
         data-yt-titulo="Episódios no canal do podcast"
         data-yt-cta="Abrir o canal do podcast"
         data-yt-rotulo="Assistir o episódio">
      <article class="quote skel"><div class="ph" style="width:100%;aspect-ratio:16/9;border-radius:14px;margin-bottom:22px"></div><div class="ph" style="width:42%;height:12px;margin-bottom:16px"></div><div class="ph" style="width:100%;height:16px;margin-bottom:9px"></div><div class="ph" style="width:72%;height:16px"></div></article>
      <article class="quote skel"><div class="ph" style="width:100%;aspect-ratio:16/9;border-radius:14px;margin-bottom:22px"></div><div class="ph" style="width:42%;height:12px;margin-bottom:16px"></div><div class="ph" style="width:100%;height:16px;margin-bottom:9px"></div><div class="ph" style="width:72%;height:16px"></div></article>
      <article class="quote skel"><div class="ph" style="width:100%;aspect-ratio:16/9;border-radius:14px;margin-bottom:22px"></div><div class="ph" style="width:42%;height:12px;margin-bottom:16px"></div><div class="ph" style="width:100%;height:16px;margin-bottom:9px"></div><div class="ph" style="width:72%;height:16px"></div></article>
      <article class="quote skel"><div class="ph" style="width:100%;aspect-ratio:16/9;border-radius:14px;margin-bottom:22px"></div><div class="ph" style="width:42%;height:12px;margin-bottom:16px"></div><div class="ph" style="width:100%;height:16px;margin-bottom:9px"></div><div class="ph" style="width:72%;height:16px"></div></article>
    </div>
  </div>
</section>

<!-- Episódios que viraram artigo -->
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head reveal" style="text-align:left;max-width:700px">
      <span class="pill"><span class="dot"></span>Para ler</span>
      <h2>Episódios que viraram artigo</h2>
      <p>Quando um episódio rende um tema que dá para aplicar na semana seguinte, ele também vira texto aqui no site. Não é transcrição: é a minha leitura do que foi dito e o que eu levaria para a sua operação.</p>
    </div>
    <div class="ilist">
{episodios.map((ep) => <Card post={ep} data={dataPorExtenso(ep.data.pubDate)} comCategoria={false} />)}
    </div>
  </div>
</section>

<!-- O que é o podcast -->
<section class="section" style="padding-top:0">
  <div class="wrap">
    <article class="post rich reveal">
      <h2>Por que esse podcast existe</h2>
      <p>Tem muito conteúdo de e-commerce explicando o que fazer e quase nenhum mostrando <b>como a decisão foi tomada</b>. A diferença importa: quando você só vê o resultado pronto, você copia a tática e erra o contexto. Quando você entende o problema que a empresa estava tentando resolver, você consegue traduzir aquilo para a sua realidade.</p>
      <p>É isso que eu procuro em cada episódio. Não o número bonito, mas o que veio antes dele: o modelo que não escalou, o canal que foi abandonado, o teste barato que mudou a curva, a aposta que custou caro. Inclusive o que deu errado, porque episódio em que tudo dá certo não ensina nada.</p>

      <h2>O que você vai ouvir aqui</h2>
      <ul>
        <li><b>Decisão de modelo.</b> Atacado contra D2C, marketplace contra loja própria, físico contra digital. Quando cada um faz sentido e o que cada escolha cobra.</li>
        <li><b>Margem e preço.</b> Política de desconto, promoção que vicia o cliente, o custo real de vender barato para vender rápido.</li>
        <li><b>Aquisição de verdade.</b> O que sustenta o CAC quando a verba sobe, e por que campanha isolada quase nunca é o que virou o jogo.</li>
        <li><b>Time e processo.</b> Quem contratar primeiro, o que manter dentro de casa, como a operação aguenta o volume que o marketing traz.</li>
        <li><b>O que não deu certo.</b> A parte mais útil de qualquer episódio, e a que a maioria dos convidados não costuma contar em palco.</li>
      </ul>

      <h2>Dois canais, dois propósitos</h2>
      <p>Vale deixar claro porque muita gente confunde. O canal <a href="https://www.youtube.com/@cristianocre" target="_blank" rel="noopener">@cristianocre</a> é onde eu ensino: aula, método, análise de operação. O canal <a href="https://www.youtube.com/@PerformanceParaResultados" target="_blank" rel="noopener">@PerformanceParaResultados</a> é o do podcast, onde eu escuto. São coisas diferentes e não se misturam.</p>
      <p>Se você prefere ler a assistir, os <a href="/insights">Insights</a> reúnem os guias escritos sobre os mesmos temas, do <a href="/trafego-pago-para-ecommerce">tráfego pago</a> à <a href="/aumentar-margem-do-ecommerce">margem</a> e à <a href="/recompra-no-ecommerce">recompra</a>.</p>

      <h2>Quem apresenta</h2>
      <div class="author-card">
        <img class="ac-photo" src="cristiano.jpg" alt="Cristiano Creczyenski, CEO da Metris" width="88" height="88" loading="lazy">
        <div>
          <div class="ac-role">Apresentador</div>
          <h3>Cristiano Creczyenski</h3>
          <p><b>Cristiano Creczyenski</b> é CEO da Metris e tem mais de <b>17 anos de experiência</b> em e-commerce e marketing digital, com atuação em marcas como Lojas Colombo, Fila, Umbro, Melissa, Coza, Continental Ferramentas, Vinhos Collection e Pizzato. Ele conduz o podcast a partir da operação real, que é onde as perguntas ficam específicas.</p>
          <div class="ac-links">
            <a href="https://www.linkedin.com/in/cristianocre/" target="_blank" rel="noopener">LinkedIn &#8599;</a>
            <a href="/diagnostico">Fazer um diagnóstico com o Cristiano &#8594;</a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- FAQ -->
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head center reveal">
      <span class="pill"><span class="dot"></span>Perguntas frequentes</span>
      <h2>Perguntas frequentes</h2>
    </div>
    <div class="faq reveal" style="max-width:760px;margin:0 auto">
      <details><summary>O que é o podcast Performance para Resultados?<span class="pm"></span></summary><div class="ans">É o podcast da Metris, apresentado por Cristiano Creczyenski, com conversas longas com donos e responsáveis por operações que vendem pela internet. O foco é a decisão por trás do resultado: o que a empresa mudou, por que mudou, o que deu errado antes e o que ela faria diferente hoje.</div></details>
      <details><summary>Onde eu escuto o podcast?<span class="pm"></span></summary><div class="ans">Os episódios em vídeo ficam no canal Performance para Resultados no YouTube, e o áudio está no Spotify. Nesta página você vê sempre os episódios mais recentes direto do canal, sem precisar sair do site.</div></details>
      <details><summary>O podcast é o mesmo canal do @cristianocre?<span class="pm"></span></summary><div class="ans">Não. São dois canais diferentes e de propósito. O @cristianocre é o canal de conteúdo e aulas do Cristiano, onde ele ensina método. O @PerformanceParaResultados é o canal do podcast, com as entrevistas. Um ensina, o outro conversa.</div></details>
      <details><summary>Com que frequência sai episódio novo?<span class="pm"></span></summary><div class="ans">A cadência é semanal. Quando um episódio rende um tema que vale ficar registrado por escrito, ele também vira um artigo aqui no site, com o resumo do que foi dito e o que dá para aplicar na sua operação.</div></details>
      <details><summary>Para quem é o podcast?<span class="pm"></span></summary><div class="ans">Para quem é dono do resultado de uma operação: dono de e-commerce, sócio, diretor comercial ou responsável pelo P&L. Não é um programa sobre como vender serviço de tráfego, é sobre como fazer uma marca crescer com margem.</div></details>
      <details><summary>Quem apresenta?<span class="pm"></span></summary><div class="ans">Cristiano Creczyenski, CEO da Metris, com mais de 17 anos em marketing de performance e e-commerce. Ele conduz o episódio a partir da operação real, então a conversa costuma descer para número, processo e decisão em vez de ficar em teoria.</div></details>
      <details><summary>Como participar do podcast como convidado?<span class="pm"></span></summary><div class="ans">O convite parte da produção e o critério é ter uma operação real e uma história com aprendizado concreto, inclusive do que não deu certo. Se você acha que é o caso, o caminho mais direto é falar com o Cristiano pelo LinkedIn ou pelo Instagram.</div></details>
      <details><summary>Os episódios viram conteúdo escrito?<span class="pm"></span></summary><div class="ans">Os que rendem tema aplicável, sim. O artigo não é uma transcrição: é a leitura do Cristiano sobre o que foi dito, com o contexto de mercado e a ligação com os guias do site. O episódio da Senplo, sobre lançamento semanal, é o exemplo mais recente.</div></details>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="diag reveal">
      <div class="diag-grid">
        <div>
          <span class="pill"><span class="dot"></span>Diagnóstico 360</span>
          <h2>Ouvir é bom. Aplicar na sua operação é melhor.</h2>
          <p>Em uma hora de análise gratuita comigo, a gente olha a sua loja do mesmo jeito que eu olho a dos convidados: onde está o gargalo real e o que muda o resultado nos próximos 90 dias.</p>
        </div>
        <aside class="diag-side">
          <div class="big">1h</div>
          <div class="cap">análise com o Cristiano</div>
          <a href="/diagnostico" class="btn btn-green btn-block">Quero meu diagnóstico <span class="ar">&#8594;</span></a>
          <p class="micro">É gratuito e sem compromisso.</p>
        </aside>
      </div>
    </div>
  </div>
</section>
</Base>
